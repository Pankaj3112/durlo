{
  "name": "@durlo/repo",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit --project test/tsconfig.json",
    "lint": "turbo run lint && eslint test",
    "test": "pnpm test:all",
    "test:unit": "vitest run --config vitest.config.ts test/core test/cli",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:quickstart && pnpm test:reference-apps",
    "test:audit": "pnpm test:release-contract && pnpm test:release && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:package && pnpm test:mutations:core && pnpm test:local:release",
    "test:local": "node scripts/test-local.mjs",
    "benchmark:local": "node scripts/test-local.mjs benchmark:postgres",
    "benchmark:postgres": "vitest run --config vitest.benchmark.config.ts",
    "test:local:coverage": "node scripts/test-local.mjs test:coverage",
    "test:local:mutations": "node scripts/test-local.mjs test:persistence-mutations",
    "test:local:privileged": "node scripts/test-local.mjs test:privileged",
    "test:local:release": "node scripts/test-local.mjs test:ci test:quickstart test:reference-apps test:privileged test:stress test:persistence-mutations",
    "test:local:stress": "node scripts/test-local.mjs test:stress",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:persistence-mutations": "node scripts/check-persistence-mutations.mjs",
    "test:mutations:core": "stryker run",
    "test:package": "node scripts/test-packed-consumer.mjs",
    "test:quickstart": "node scripts/test-phase4-quickstart.mjs",
    "test:registry": "node scripts/test-packed-consumer.mjs --registry",
    "test:registry-quickstart": "node scripts/test-phase4-quickstart.mjs --registry",
    "test:reference-apps": "node scripts/test-reference-apps.mjs",
    "test:release-contract": "node scripts/check-release-contract.mjs",
    "test:release": "node --test test/release-plan.test.mjs test/provenance.test.mjs test/release-registry.test.mjs",
    "release:audit": "node scripts/release.mjs audit",
    "test:privileged": "vitest run --config vitest.privileged.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "format": "prettier --write \"**/*.{js,ts,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@standard-schema/spec": "1.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "prettier": "^3.9.4",
    "pg": "^8.22.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
