{
  "name": "@durlo/cli",
  "version": "0.0.0",
  "description": "Durlo CLI package.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "durlo": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts test/cli/index.test.ts"
  },
  "dependencies": {
    "@durlo/core": "workspace:*",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
