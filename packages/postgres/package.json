{
  "name": "@durlo/postgres",
  "version": "0.1.0-alpha.1",
  "description": "PostgreSQL persistence and migrations for Durlo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pankaj3112/durlo.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://github.com/Pankaj3112/durlo#readme",
  "bugs": {
    "url": "https://github.com/Pankaj3112/durlo/issues"
  },
  "keywords": [
    "durable-tasks",
    "workflows",
    "postgresql",
    "typescript",
    "background-jobs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --dir ../.. test:integration"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@durlo/core": "workspace:0.1.0-alpha.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0"
  }
}
